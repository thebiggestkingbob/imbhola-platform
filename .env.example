# Local synthetic workspaces are enabled by npm run dev:local.
# Hosted builds serve the public website. Do not use real workforce data in local fixtures.

# Disabled until the production database and identity provider are verified.
# IMBHOLA_ENABLE_PRODUCTION_WORKSPACE=0
# IMBHOLA_DATABASE_URL=
# IMBHOLA_IDENTITY_ISSUER=
# IMBHOLA_IDENTITY_JWKS_URL=
# IMBHOLA_IDENTITY_AUDIENCE=
# Optional managed sign-in configuration.
# IMBHOLA_IDENTITY_MODE=descope
# NEXT_PUBLIC_DESCOPE_PROJECT_ID=
