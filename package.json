{
  "name": "imbhola-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "dev:local": "IMBHOLA_LOCAL=1 next dev --hostname 127.0.0.1",
    "seed:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/local/seed.ts",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/local/*.test.ts"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0",
    "eslint-config-next": "^15.5.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33",
      "sharp": "0.35.5"
    }
  }
}
